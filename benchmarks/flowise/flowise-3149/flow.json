        "id": "customFunction_0",
        "name": "customFunction",
        "label": "Get Database Schema",
        "category": "Utilities",
        "inputAnchors": [],
        "inputParams": [
          { "id": "customFunction_0-input-functionInputVariables-json", "name": "functionInputVariables", "type": "json" },
          { "id": "customFunction_0-input-javascriptFunction-code", "name": "javascriptFunction", "type": "code" }
        ],
        "inputs": {
          "javascriptFunction": "const { Client } = require('pg');\nconst client = new Client({ connectionString: $vars.PG_URL });\nawait client.connect();\nconst res = await client.query(\"SELECT table_name, column_name, data_type FROM information_schema.columns WHERE table_schema='public'\");\nawait client.end();\nconst schema = res.rows.map(r => `${r.table_name}.${r.column_name} ${r.data_type}`).join('\\n');\nconsole.log(schema);\nreturn schema;"
        },
        "outputAnchors": [
          {
            "name": "output",
            "label": "Output",
            "type": "options",
            "options": [
              { "id": "customFunction_0-output-output-string|number|boolean|json|array", "name": "output", "label": "Output", "type": "string | number | boolean | json | array" }
            ]
          }
        ]
      }
    },

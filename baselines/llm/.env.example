# Copy to baselines/llm/.env (git-ignored) and fill in the key of each provider you run.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# The profiles of the paper's runs, used as: python3 baselines/llm/run_llm.py --profile gpt_xhigh
PROFILE_gpt_xhigh=openai/gpt-5.5/xhigh
PROFILE_claude_xhigh=anthropic/claude-opus-4-8/xhigh
PROFILE_deepseek_max=deepseek/deepseek-v4-pro/max
